From 192f957f5ccd1930a81469769d0c54feeb0419ae Mon Sep 17 00:00:00 2001
From: Aman Surkar <Aman.Surkar@ibm.com>
Date: Mon, 11 Aug 2025 08:53:44 +0000
Subject: [PATCH] Fixed build

---
 recipe/build.sh                  |  3 +++
 recipe/install_clang_symlinks.sh |  2 +-
 recipe/meta.yaml                 | 10 +++++-----
 3 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/recipe/build.sh b/recipe/build.sh
index 1267479..35938f8 100644
--- a/recipe/build.sh
+++ b/recipe/build.sh
@@ -45,6 +45,9 @@ fi
 mkdir build
 cd build
 
+export CXXFLAGS="${CXXFLAGS} -fplt"
+export CFLAGS="${CFLAGS} -fplt"
+
 cmake \
   -DCMAKE_INSTALL_PREFIX=$PREFIX \
   -DCMAKE_PREFIX_PATH=$PREFIX \
diff --git a/recipe/install_clang_symlinks.sh b/recipe/install_clang_symlinks.sh
index 59a613f..62e594d 100644
--- a/recipe/install_clang_symlinks.sh
+++ b/recipe/install_clang_symlinks.sh
@@ -1,6 +1,6 @@
 #!/bin/bash
 set -ex
-
+mkdir -p "${PREFIX}/bin"
 maj_version="${PKG_VERSION%%.*}"
 ln -s "${PREFIX}/bin/clang-${maj_version}" "${PREFIX}/bin/clang-cl"
 ln -s "${PREFIX}/bin/clang-${maj_version}" "${PREFIX}/bin/clang-cpp"
diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 7561bc7..87ecb45 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -55,7 +55,7 @@ requirements:
   host:
     - libcxx {{ cxx_compiler_version }}  # [osx]
     - llvmdev =={{ version }}
-    - zlib                               # [linux]
+    - zlib                    # [linux]
 
 test:
   requires:
@@ -99,7 +99,7 @@ outputs:
         - {{ pin_subpackage("libclang-cpp", exact=True) }}
         - libcxx {{ cxx_compiler_version }}  # [osx]
         - llvmdev =={{ version }}
-        - zlib                               # [linux]
+        - zlib                    # [linux]
       run:
         - {{ pin_subpackage("clang", exact=True) }}
         - {{ pin_subpackage("clangxx", exact=True) }}
@@ -366,7 +366,7 @@ outputs:
         - libcxx {{ cxx_compiler_version }}  # [osx]
         - llvmdev =={{ version }}
         - llvm =={{ version }}
-        - zlib                            # [linux or win]
+        - zlib                 # [linux or win]
         - libxml2                         # [win]
       run:
         - {{ pin_compatible("libcxx", max_pin=None) }}  # [osx]
@@ -404,7 +404,7 @@ outputs:
         - libcxx {{ cxx_compiler_version }}  # [osx]
         - llvmdev =={{ version }}
         - llvm =={{ version }}
-        - zlib                               # [linux or win]
+        - zlib                            # [linux or win]
       run:
         - {{ pin_compatible("libcxx", max_pin=None) }}  # [osx]
         - {{ pin_subpackage("libclang-cpp" + minor_aware_ext, max_pin="x.x") }}   # [unix]
@@ -440,7 +440,7 @@ outputs:
         - libcxx {{ cxx_compiler_version }}  # [osx]
         - llvmdev =={{ version }}
         - llvm =={{ version }}
-        - zlib                               # [linux or win]
+        - zlib                           # [linux or win]
       run:
         - ucrt                                          # [win]
         - {{ pin_compatible("libcxx", max_pin=None) }}  # [osx]
-- 
2.40.1

