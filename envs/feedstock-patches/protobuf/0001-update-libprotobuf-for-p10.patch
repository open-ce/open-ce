From 6a26f11630c3d35e749790631e95a12308580fc6 Mon Sep 17 00:00:00 2001
From: Archana-Shinde1 <archana.shinde1@ibm.com>
Date: Thu, 14 Aug 2025 12:08:01 +0000
Subject: [PATCH] Fixed p10 build failure

---
 recipe/build-lib.sh |  4 ++++
 recipe/meta.yaml    | 26 +++++++++++++++-----------
 2 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/recipe/build-lib.sh b/recipe/build-lib.sh
index 044c3c2..cee02f8 100644
--- a/recipe/build-lib.sh
+++ b/recipe/build-lib.sh
@@ -49,8 +49,12 @@ cmake -G "Ninja" \
     -Dprotobuf_JSONCPP_PROVIDER="package" \
     -Dprotobuf_USE_EXTERNAL_GTEST=ON \
     -Dprotobuf_WITH_ZLIB=ON \
+    -DCMAKE_INSTALL_PREFIX=${PREFIX} \
+    -DCMAKE_INSTALL_LIBDIR=lib \
     ..
 
+export LD_LIBRARY_PATH="${PREFIX}/lib:${BUILD_PREFIX}/lib:${LD_LIBRARY_PATH}"
+
 cmake --build .
 
 if [[ "$CONDA_BUILD_CROSS_COMPILATION" != 1 ]]; then
diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 90b6d91..c7a44cc 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -1,5 +1,5 @@
 # keep this without major version to let the bot pick it up
-{% set version = "25.3" %}
+{% set version = "25.8" %}
 # protobuf doesn't add the major version in the tag, it's defined per language in
 # https://github.com/protocolbuffers/protobuf/blob/main/version.json
 {% set major = "4" %}
@@ -12,7 +12,7 @@ package:
 
 source:
   - url: https://github.com/protocolbuffers/protobuf/archive/refs/tags/v{{ version.replace(".rc", "-rc") }}.tar.gz
-    sha256: d19643d265b978383352b3143f04c0641eea75a75235c111cc01a1350173180e
+    sha256: 5a5d91be7a47b15cecebdc24188e5cfd0a2fc0af03ae93fa239e842c4a5128d0
     patches:
       - patches/0001-use-consistent-cmake-location.patch
       - patches/0002-set-static-lib-extension-on-windows.patch
@@ -49,14 +49,14 @@ outputs:
         - jsoncpp
     requirements:
       build:
-        - {{ compiler('c') }}
-        - {{ compiler('cxx') }}
+        - {{ compiler('c') }}        #[ppc_arch != "p10"]
+        - {{ compiler('cxx') }}      #[ppc_arch != "p10"]
         - cmake
         - ninja
       host:
         - gtest
         - jsoncpp
-        - libabseil
+        - libabseil {{ abseil_cpp }}
         # requires abseil test targets to build with tests enabled
         - libabseil-tests
         - zlib
@@ -70,7 +70,7 @@ outputs:
       requires:
         # cmake needs compiler to be able to run package detection, see
         # https://discourse.cmake.org/t/questions-about-find-package-cli-msvc/6194
-        - {{ compiler('cxx') }}
+        - {{ compiler('cxx') }}      #[ppc_arch != "p10"]
         - cmake
         - ninja
         - pkg-config
@@ -118,27 +118,31 @@ outputs:
         - jsoncpp
     requirements:
       build:
-        - {{ compiler('c') }}
-        - {{ compiler('cxx') }}
+        - {{ compiler('c') }}         #[ppc_arch != "p10"]
+        - {{ compiler('cxx') }}       #[ppc_arch != "p10"]
         - cmake
         - ninja
       host:
         - gtest
         - jsoncpp
-        - libabseil
+        - libabseil {{ abseil_cpp }}
         - libabseil-tests
         - zlib
         - {{ pin_subpackage('libprotobuf', exact=True) }}
       run:
         - {{ pin_subpackage('libprotobuf', exact=True) }}
+        - libabseil {{ abseil_cpp }}
+        - libabseil-tests
+        - zlib
     test:
       requires:
         # cmake needs compiler to be able to run package detection, see
         # https://discourse.cmake.org/t/questions-about-find-package-cli-msvc/6194
-        - {{ compiler('cxx') }}
+        - {{ compiler('cxx') }}       #[ppc_arch != "p10"]
         - cmake
         - ninja
         - zlib
+        - xz
       files:
         - cmake_test/
       commands:
@@ -159,7 +163,7 @@ outputs:
     script: build-pyheaders.bat  # [win]
     requirements:
       build:
-        - rsync  # [unix]
+#        - rsync  # [unix]
       host:
         - {{ pin_subpackage('libprotobuf', exact=True) }}
       run_constrained:
-- 
2.40.1

