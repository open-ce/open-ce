From a29b060fd8c2feee98e8af4a787d20977b7b2a2c Mon Sep 17 00:00:00 2001
From: Aman Surkar <Aman.Surkar@ibm.com>
Date: Wed, 20 Aug 2025 12:03:10 +0000
Subject: [PATCH] Fixed CVEs for libprotobuf

---
 recipe/build-lib.sh                           |   7 +-
 recipe/build-shared.sh                        |  27 +-
 recipe/meta.yaml                              |  12 +-
 ...ackported-CVE-2025-4565-for-protobuf.patch | 272 ++++++++++++++++++
 4 files changed, 306 insertions(+), 12 deletions(-)
 create mode 100644 recipe/patches/0001-Backported-CVE-2025-4565-for-protobuf.patch

diff --git a/recipe/build-lib.sh b/recipe/build-lib.sh
index 6071cec..496df37 100644
--- a/recipe/build-lib.sh
+++ b/recipe/build-lib.sh
@@ -5,11 +5,12 @@ if [ "$(uname)" == "Linux" ];
 then
     # protobuf uses PROTOBUF_OPT_FLAG to set the optimization level
     # unit test can fail if optmization above 0 are used.
-    CPPFLAGS="${CPPFLAGS//-O[0-9]/}"
-    CXXFLAGS="${CXXFLAGS//-O[0-9]/}"
+#    CPPFLAGS="${CPPFLAGS//-O[0-9]/}"
+#    CXXFLAGS="${CXXFLAGS//-O[0-9]/}"
     export PROTOBUF_OPT_FLAG="-O2"
     # to improve performance, disable checks intended for debugging
-    CXXFLAGS="$CXXFLAGS -DNDEBUG"
+    CXXFLAGS="$CXXFLAGS -DNDEBUG -fplt"
+    CFLAGS="$CFLAGS -fplt"
 elif [ "$(uname)" == "Darwin" ];
 then
     # remove pie from LDFLAGS
diff --git a/recipe/build-shared.sh b/recipe/build-shared.sh
index ca7bc09..a19db9c 100644
--- a/recipe/build-shared.sh
+++ b/recipe/build-shared.sh
@@ -2,15 +2,32 @@
 
 set -ex
 
+ARCH=$(uname -m)
+NO_OF_MAKE_THREADS=128
+if [[ $ARCH == "ppc64le" ]]; then
+    if [ -z ${LIMIT_BUILD_RESOURCES+x} ];
+    then
+        echo "ERROR: LIMIT_BUILD_RESOURCES is unset. Please set it to 1 if the build system is low in resources, else set it to 0"
+        exit 1
+    else
+        echo "LIMIT_BUILD_RESOURCES is set to $LIMIT_BUILD_RESOURCES"
+        if [[ ${LIMIT_BUILD_RESOURCES} == true || ${LIMIT_BUILD_RESOURCES} == 1 ]];
+        then
+            NO_OF_MAKE_THREADS=8
+        fi
+    fi
+fi
+
 if [ "$(uname)" == "Linux" ];
 then
     # protobuf uses PROTOBUF_OPT_FLAG to set the optimization level
     # unit test can fail if optmization above 0 are used.
-    CPPFLAGS="${CPPFLAGS//-O[0-9]/}"
-    CXXFLAGS="${CXXFLAGS//-O[0-9]/}"
+#    CPPFLAGS="${CPPFLAGS//-O[0-9]/}"
+#    CXXFLAGS="${CXXFLAGS//-O[0-9]/}"
     export PROTOBUF_OPT_FLAG="-O2"
     # to improve performance, disable checks intended for debugging
-    CXXFLAGS="$CXXFLAGS -DNDEBUG"
+    CXXFLAGS="$CXXFLAGS -DNDEBUG -fplt"
+    CFLAGS="$CFLAGS -fplt"
 elif [ "$(uname)" == "Darwin" ];
 then
     # remove pie from LDFLAGS
@@ -43,9 +60,9 @@ if [ "${HOST}" == "powerpc64le-conda_cos7-linux-gnu" ]; then
     make -j 2
     make check -j 2 || (cat src/test-suite.log; exit 1)
 else
-    make -j ${CPU_COUNT}
+    make -j $NO_OF_MAKE_THREADS
     if [[ "$CONDA_BUILD_CROSS_COMPILATION" != 1 ]]; then
-        make check -j ${CPU_COUNT} || (cat src/test-suite.log; exit 1)
+        make check -j $NO_OF_MAKE_THREADS || (cat src/test-suite.log; exit 1)
     fi
 fi
 make install
diff --git a/recipe/meta.yaml b/recipe/meta.yaml
