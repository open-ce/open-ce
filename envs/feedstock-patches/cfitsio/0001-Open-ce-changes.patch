 recipe/meta.yaml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 78510b7..50f916f 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -2,7 +2,7 @@
 {% set version = "3.470" %}
 {% set nozeroversion = version[:-1] %}
 # This is the SHA256 hash of the ungzipped tar file. See https://github.com/conda/conda/issues/3798.
-{% set sha256 = "985606e058403c073a68d95be74e9696f0ded9414520784457a1d4cba8cca7e2" %}
+{% set sha256 = "418516f10ee1e0f1b520926eeca6b77ce639bed88804c7c545e74f26b3edf4ef" %}
 
 package:
   name: {{ name }}
@@ -17,7 +17,7 @@ source:
     - lcurl-pkg-config.patch
 
 build:
-  number: 7
+  number: 8
   ignore_run_exports:
     - libgfortran5  # [osx]
   run_exports:
@@ -35,7 +35,7 @@ requirements:
   host:
     - libcurl  # [not win]
     - bzip2  # [not win]
-    - zlib  # [not win]
+    - zlib {{ zlib }} # [not win]
 
 test:
   commands:
