From: Archana-Shinde1 <Archana.Shinde1@ibm.com>
Date: Fri, 3 Jan 2025 11:13:12 +0000
Subject: [PATCH] Update patch to fix build failure

---
 recipe/meta.yaml | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 795b445..919be6c 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -18,14 +18,15 @@ requirements:
     - {{ compiler('cxx') }}
     - {{ compiler('c') }}
     - cross-python_{{ target_platform }}   # [build_platform != target_platform]
-    - python                               # [build_platform != target_platform]
-    - numpy                                # [build_platform != target_platform]
+    - python {{ python }}                  # [build_platform != target_platform]
+    - numpy {{ numpy }}                    # [build_platform != target_platform]
     - pybind11 >=2.10.0,<2.11.dev0         # [build_platform != target_platform]
   host:
-    - python
-    - numpy
+    - python {{ python }}
+    - numpy {{ numpy }}
     - pybind11 >=2.10.0,<2.11.dev0
-    - setuptools >=67.6.0,<67.7.dev0
+    - setuptools 65.*               #[cudatoolkit == "11.2"]
+    - setuptools {{ setuptools }}   #[cudatoolkit == "11.8" or build_type == "cpu"]
     - pip
   run:
     - python
@@ -42,10 +43,13 @@ test:
   requires:
     - pip
     - pytest
+    - py
     - pytest-xdist
     - pylint >=2.6.0
     - pyink
     - absl-py
+    - aiohttp
+    - black ==24.8.0
 
 about:
   home: https://pypi.org/project/ml-dtypes/
