From f8afd7826750b98bb0dbee8d3dd43e4b2838c242 Mon Sep 17 00:00:00 2001
From: Aman-Surkar1 <Aman.Surkar1@ibm.com>
Date: Wed, 28 Jan 2026 09:22:40 +0000
Subject: [PATCH] Relaxed setuptools pin in runtime

---
 recipe/meta.yaml | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 4c942ad..0a9c38f 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -19,15 +19,15 @@ outputs:
       noarch: python
     requirements:
       host:
-        - python {{ python_min }}
+        - python
         - pip
         - packaging >=20
-        - setuptools >=61
+        - setuptools {{ setuptools }}
         - tomli
       run:
-        - python >={{ python_min }}
+        - python
         - packaging >=20.0
-        - setuptools >=45
+        - setuptools
         - tomli >=1.0.0
         - typing-extensions
         - importlib-metadata
@@ -37,7 +37,7 @@ outputs:
       commands:
         - pip check
       requires:
-        - python {{ python_min }}
+        - python
         - pip
 
   - name: setuptools_scm
-- 
2.40.1

