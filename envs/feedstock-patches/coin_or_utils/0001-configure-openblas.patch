From 358764d8d93832ae2baece88b555b39d0d9979f7 Mon Sep 17 00:00:00 2001
From: Aman Surkar <Aman.Surkar@ibm.com>
Date: Mon, 11 Aug 2025 09:03:45 +0000
Subject: [PATCH] Fixed build

---
 config/conda_build_config.yaml | 6 ++++++
 recipe/build.sh                | 6 +++---
 recipe/meta.yaml               | 7 ++-----
 3 files changed, 11 insertions(+), 8 deletions(-)
 create mode 100644 config/conda_build_config.yaml

diff --git a/config/conda_build_config.yaml b/config/conda_build_config.yaml
new file mode 100644
index 0000000..c823874
--- /dev/null
+++ b/config/conda_build_config.yaml
@@ -0,0 +1,6 @@
+c_compiler_version:
+  - 11.*          # [cudatoolkit == "11.2"]
+cxx_compiler_version:
+  - 11.*          # [cudatoolkit == "11.2"]
+fortran_compiler_version:
+  - 11.*          # [cudatoolkit == "11.2"]
diff --git a/recipe/build.sh b/recipe/build.sh
index 88e404d..49ff12a 100644
--- a/recipe/build.sh
+++ b/recipe/build.sh
@@ -19,8 +19,8 @@ fi
 # value at run-time to get the expected amount of parallelism.
 export OPENBLAS_NUM_THREADS=1
 
-WITH_BLAS_LIB="-L${PREFIX}/lib -lblas"
-WITH_LAPACK_LIB="-L${PREFIX}/lib -llapack"
+WITH_BLAS_LIB="-L${PREFIX}/lib -lopenblas"
+WITH_LAPACK_LIB="-L${PREFIX}/lib -lopenblas"
 
 ./configure \
     --prefix="${PREFIX}" \
@@ -29,4 +29,4 @@ WITH_LAPACK_LIB="-L${PREFIX}/lib -llapack"
     --with-lapack-lib="${WITH_LAPACK_LIB}" \
 
 make -j "${CPU_COUNT}"
-make install
\ No newline at end of file
+make install
diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index a207bf5..79887b6 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -23,15 +23,12 @@ requirements:
     - {{ compiler('c') }}
     - {{ compiler('cxx') }}
     - {{ compiler('fortran') }}
-    - pkg-config
+    - pkg-config {{ pkgconfig }}
     - make  # [unix]
   host:
     - zlib
     - bzip2
-    - libblas
-    - libcblas
-    - liblapack
-    - liblapacke
+    - openblas {{ openblas }}
   run_constrained:
     - coincbc * *_metapackage
 
-- 
2.40.1

