+From b89f6b1149c508459553303f167764660a2c13c8 Mon Sep 17 00:00:00 2001
+From: Aman Surkar <Aman.Surkar@ibm.com>
+Date: Fri, 5 Sep 2025 09:13:34 +0000
+Subject: [PATCH] Backported CVE-2025-5197
+
+---
+ src/transformers/modeling_tf_pytorch_utils.py | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/src/transformers/modeling_tf_pytorch_utils.py b/src/transformers/modeling_tf_pytorch_utils.py
+index 99fa106674..2b9de781b3 100644
+--- a/src/transformers/modeling_tf_pytorch_utils.py
++++ b/src/transformers/modeling_tf_pytorch_utils.py
+@@ -65,6 +65,9 @@ def convert_tf_weight_name_to_pt_weight_name(
+         tf_name = tf_name[len(name_scope) :]
+         tf_name = tf_name.lstrip("/")
+     tf_name = tf_name.replace(":0", "")  # device ids
++    if (len(tf_name) > 2048 and "___" in tf_name) or tf_name.count("___") > 10:
++        # ReDOS check
++        raise ValueError("TF variable name is too long or contains too many ___ separators: " + tf_name)
+     tf_name = re.sub(
+         r"/[^/]*___([^/]*)/", r"/\1/", tf_name
+     )  # '$1___$2' is replaced by $2 (can be used to duplicate or remove layers in TF2.0 vs PyTorch)
