index 31f6612..cc5d8ef 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -1,5 +1,5 @@
 {% set name = "uWSGI" %}
-{% set version = "2.0.23" %}
+{% set version = "2.0.25.1" %}
 
 package:
   name: {{ name|lower }}
@@ -7,7 +7,7 @@ package:
 
 source:
   url: https://pypi.io/packages/source/{{ name[0] }}/{{ name }}/{{ name|lower }}-{{ version }}.tar.gz
-  sha256: 0cafda0c16f921db7fe42cfaf81b167cf884ee17350efbdd87d1ecece2d7de37
+  sha256: d653d2d804c194c8cbe2585fa56efa2650313ae75c686a9d7931374d4dfbfc6e
 
 build:
   number: 0
@@ -18,28 +18,31 @@ requirements:
   build:
     - {{ compiler('c') }}
     - {{ compiler('cxx') }}
-    - python                                 # [build_platform != target_platform]
+    - python {{python}}                      # [build_platform != target_platform]
     - cross-python_{{ target_platform }}     # [build_platform != target_platform]
   host:
-    - icu
+    - icu 73
+    - libxcrypt
     - jansson
     - libpython-static
     - libxml2  # [not win]
     - openssl
     - pcre
-    - pip
-    - python
+    - pip {{pip}}
+    - python {{python}}
     - yaml
     - zlib
   run:
     - jansson
-    - python
+    - python {{python}}
 
 test:
   source_files:
     - tests
+  recipe:
+    - run_test.sh
   commands:
-    - uwsgi --plugin-list
+    - ./run_test.sh
     - uwsgi --version
 
 about:
diff --git a/recipe/run_test.sh b/recipe/run_test.sh
index 6d8e0c9..a4e9234 100644
--- a/recipe/run_test.sh
+++ b/recipe/run_test.sh
@@ -17,15 +17,22 @@ fi
 ERROR=0
 SUCCESS=0
 
+ARCH="$(arch)"
+if [ ${ARCH} = "x86_64" ]; then
+    pidof() {
+        pgrep -f '[u]wsgi' | tr '\n' ' '
+    }
+else
+    pidof() {
+        local pids=$(ps axc | awk "{if (\$5==\"$1\") print \$1}" | tr '\n' ' ')
+        if [[ -n $pids ]]; then
+           echo "$pids"
+        else
+           return 1;
+        fi
+    }
+fi
 
-pidof() {
