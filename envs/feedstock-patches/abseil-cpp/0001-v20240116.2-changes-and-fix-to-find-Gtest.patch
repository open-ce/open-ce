diff --git a/recipe/patches/0001-cmake-use-gtest-config.patch b/recipe/patches/0001-cmake-use-gtest-config.patch
new file mode 100644
index 0000000..247b337
--- /dev/null
+++ b/recipe/patches/0001-cmake-use-gtest-config.patch
@@ -0,0 +1,25 @@
+From e70e8878d9e83e5c322f2c6cb6f08cc08cddd0b7 Mon Sep 17 00:00:00 2001
+From: "Archana.Shinde1" <archana.shinde1@ibm.com>
+Date: Fri, 1 Aug 2025 07:07:49 +0000
+Subject: [PATCH] cmake use gtest config
+
+---
+ CMakeLists.txt | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+index 194f8708..58cc737f 100644
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -152,7 +152,7 @@ set(ABSL_LOCAL_GOOGLETEST_DIR "/usr/src/googletest" CACHE PATH
+ if((BUILD_TESTING AND ABSL_BUILD_TESTING) OR ABSL_BUILD_TEST_HELPERS)
+   if (ABSL_USE_EXTERNAL_GOOGLETEST)
+     if (ABSL_FIND_GOOGLETEST)
+-      find_package(GTest REQUIRED)
++      find_package(GTest CONFIG REQUIRED)
+     elseif(NOT TARGET GTest::gtest)
+       if(TARGET gtest)
+         # When Google Test is included directly rather than through find_package, the aliases are missing.
+-- 
+2.40.1
+
-- 
