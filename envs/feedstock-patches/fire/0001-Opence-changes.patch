---
 recipe/meta.yaml | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 95bf56d..3445d18 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -17,14 +17,16 @@ build:
 
 requirements:
   host:
-    - python
